{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": ["bun-types"]
  },
  "include": [
    "*.ts",
    "lib/**/*.ts",
    "commands/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts"
  ]
}
